<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>cutt.is</title>
    
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%23FF5A1F'/%3E%3Ctext x='50' y='72' font-family='sans-serif' font-weight='bold' font-size='65' text-anchor='middle' fill='white'%3Ec%3C/text%3E%3C/svg%3E">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary-orange: #4F46E5;
            --text-color: #FFFFFF;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            width: 100%;
            overflow: hidden;
            background-color: var(--primary-orange);
            font-family: 'Manrope', -apple-system, BlinkMacSystemFont, sans-serif;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }

        .container {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            height: 100vh;
            width: 100%;
            position: relative;
        }

        .brand-name {
            font-size: clamp(3rem, 15vw, 12rem);
            font-weight: 800;
            color: var(--text-color);
            letter-spacing: -0.04em;
            line-height: 1;
            cursor: default;
            position: relative;
            z-index: 10;
            opacity: 0;
            transform: translateY(20px);
            animation: fadeUp 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
        }

        .dot {
            color: #A3E635;
        }

        .status-wrapper {
            position: absolute;
            bottom: 40px;
            display: flex;
            align-items: center;
            gap: 10px;
            z-index: 10;
            opacity: 0;
            animation: fadeIn 1s ease-out 0.8s forwards;
        }

        .status-text {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.875rem;
            font-weight: 500;
            letter-spacing: 0.02em;
        }

        .status-indicator {
            width: 8px;
            height: 8px;
            background-color: #FFFFFF;
            border-radius: 50%;
            position: relative;
        }

        .status-indicator::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 100%;
            height: 100%;
            background-color: inherit;
            border-radius: 50%;
            opacity: 0.6;
            animation: pulse 2s infinite cubic-bezier(0.4, 0, 0.6, 1);
        }

        .noise-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.03;
            pointer-events: none;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
            z-index: 1;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(40px) scale(0.98); }
            to { opacity: 1; transform: translateY(0) scale(1); }
        }

        @keyframes fadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        @keyframes pulse {
            0% { transform: translate(-50%, -50%) scale(1); opacity: 0.6; }
            100% { transform: translate(-50%, -50%) scale(3); opacity: 0; }
        }

        ::selection {
            background: #FFFFFF;
            color: var(--primary-orange);
        }
    </style>
</head>
<body>

    <div class="container">
        <div class="noise-overlay"></div>
        
        <h1 class="brand-name">
            cutt<span class="dot">.</span>is
        </h1>

        @if(link && !is_enable)
        <div class="status-wrapper">
            <span class="status-text">This link has expired. Please contact the person who sent you this link for a new one.</span>
        </div>
        @endif
    </div>

</body>
</html>